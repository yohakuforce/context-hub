# ============================================================
# Context-Hub — Personal Profile
# ============================================================
# `context-hub init --profile personal` copies this file to .env and fills in
# a freshly generated DEV_API_KEY for you. (Manual copy to .env also works.)
#
# Profile: personal
#   - DB: SQLite (file, persistent single-user)
#   - Scheduler: sqlite (jobs survive restarts)
#   - Ingest: mock by default; set SLACK_BOT_TOKEN to enable live Slack
#   - LLM: Ollama (local, no API cost)
#   - Embedding: BGE-M3 (local FlagEmbedding, 1024-dim)
#
# Requirements:
#   - Ollama running locally (https://ollama.com)
#   - FlagEmbedding installed: pip install FlagEmbedding
#
# Switch profile:
#   CH_PROFILE=quickstart  → minimal setup, mock embedding, in-memory scheduler
#   CH_PROFILE=production  → PostgreSQL + live ingest + claude-code LLM
# ============================================================

# Active profile
CH_PROFILE=personal

# App
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-secret-at-least-32-chars

# Admin GUI / REST auth key (development only)
# Authorises the Admin GUI (/admin) and all REST data calls while
# APP_ENV=development. `context-hub init` auto-generates a value here; to set
# one manually run:  openssl rand -hex 24
# NOTE: ignored when APP_ENV=production (issue a consumer ADMIN key instead).
DEV_API_KEY=

# Database (SQLite file — persistent)
DATABASE_URL=sqlite+aiosqlite:///./data/context_hub.db
CH_SQLITE_DB=./data/context_hub.db

# Scheduler backend
# sqlite = persistent SQLite file, jobs survive restarts
SCHEDULER_BACKEND=sqlite
SCHEDULER_SQLITE_DB=./data/scheduler.db

# Serve-resident automatic source sync (re-syncs each enabled source on its
# syncInterval while `context-hub serve` is running). Set false to disable.
# CH_SOURCE_SYNC_ENABLED=true

# Ingest mode
# mock = fixture data (default)
# live = real API calls (requires tokens below)
INGEST_MODE=mock

# LLM provider (Ollama — local, zero API cost)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding provider (BGE-M3 — local, 1024-dim)
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_DEVICE=cpu

# --- Slack integration (set INGEST_MODE=live to activate) ---
# SLACK_BOT_TOKEN=xoxb-your-token

# --- Backlog integration (set INGEST_MODE=live to activate) ---
# BACKLOG_API_KEY=your-api-key
# BACKLOG_SPACE_KEY=your-space-key

# --- Redmine integration (set INGEST_MODE=live to activate) ---
# REDMINE_API_KEY=your-api-key
# REDMINE_BASE_URL=http://your-redmine.example.com

# --- Gmail ingest (requires `pip install '...[gmail]'` + INGEST_MODE=live) ---
# Default GMAIL_QUERY ingests only emails labelled "context-hub" in Gmail —
# explicit opt-in so private mail stays out of the index.
# GMAIL_CREDENTIALS_FILE=~/.context-hub/gmail/credentials.json
# GMAIL_TOKEN_FILE=~/.context-hub/gmail/token.json
# GMAIL_QUERY=label:context-hub

# --- Inbox folder watcher ---
# Drop .md / .txt files into <CH_INBOX_DIR>/{meeting,file,email}/ to auto-ingest.
# CH_INBOX_DIR=~/.context-hub/inbox
# CH_INBOX_POLL_SECONDS=60
# CH_PROJECT_ID=    # set only if more than one project exists in the DB
