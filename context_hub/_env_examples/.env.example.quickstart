# ============================================================
# Context-Hub — Quickstart Profile
# ============================================================
# Copy this file to .env in the project root to get started:
#   cp examples/env/.env.example.quickstart .env
#
# Profile: quickstart
#   - DB: SQLite (file, no Postgres required)
#   - Scheduler: in-memory (jobs lost on restart, suitable for dev)
#   - Ingest: mock (no API keys needed)
#   - LLM: ollama (optional — falls back to mock if Ollama is not running)
#   - Embedding: mock (hash-based 1024-dim, zero install cost)
#
# Switch profile:
#   CH_PROFILE=personal   → persistent SQLite scheduler + Ollama + BGE-M3
#   CH_PROFILE=production → PostgreSQL + live ingest + claude-code LLM
# ============================================================

# Active profile
CH_PROFILE=quickstart

# App
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=insecure-dev-secret-change-in-production

# Database (SQLite file — no Postgres required)
DATABASE_URL=sqlite+aiosqlite:///./data/context_hub.db
CH_SQLITE_DB=./data/context_hub.db

# Scheduler backend
# memory = in-process, no persistence (quickstart default)
SCHEDULER_BACKEND=memory
SCHEDULER_SQLITE_DB=./data/scheduler.db

# Ingest mode
# mock = fixture data, no real API keys needed
INGEST_MODE=mock

# LLM provider
# ollama = local Ollama server (optional; mock used if unavailable)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding provider
# mock = hash-based 1024-dim vectors (zero install cost)
EMBEDDING_PROVIDER=mock
EMBEDDING_DEVICE=cpu

# --- Optional: Slack integration (leave blank for mock ingest) ---
# SLACK_BOT_TOKEN=xoxb-your-token

# --- Optional: Backlog integration ---
# BACKLOG_API_KEY=your-api-key
# BACKLOG_SPACE_KEY=your-space-key

# --- Optional: Redmine integration ---
# REDMINE_API_KEY=your-api-key
# REDMINE_BASE_URL=http://your-redmine.example.com

# --- Optional: Gmail ingest (requires `pip install '...[gmail]'`) ---
# Default GMAIL_QUERY ingests only emails labelled "context-hub" in Gmail —
# explicit opt-in so private mail stays out of the index. Override to any
# Gmail search syntax for broader filters.
# GMAIL_CREDENTIALS_FILE=~/.context-hub/gmail/credentials.json
# GMAIL_TOKEN_FILE=~/.context-hub/gmail/token.json
# GMAIL_QUERY=label:context-hub

# --- Optional: Inbox folder watcher ---
# Drop .md / .txt files into <CH_INBOX_DIR>/{meeting,file,email}/ to auto-ingest.
# CH_INBOX_DIR=~/.context-hub/inbox
# CH_INBOX_POLL_SECONDS=60
# CH_PROJECT_ID=    # set only if more than one project exists in the DB
