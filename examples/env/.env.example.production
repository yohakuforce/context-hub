# ============================================================
# Context-Hub — Production Profile
# ============================================================
# Copy this file to .env in the project root (or inject as container env):
#   cp examples/env/.env.example.production .env
#
# Profile: production
#   - DB: PostgreSQL (pgvector recommended)
#   - Scheduler: postgres (persistent, cluster-safe)
#   - Ingest: live (real Slack / Backlog / Redmine API calls)
#   - LLM: claude-code (subprocess, subscription-based, zero pay-per-token)
#   - Embedding: BGE-M3 (local FlagEmbedding, 1024-dim)
#
# REQUIRED fields (no default — deployment will fail without these):
#   DATABASE_URL, SECRET_KEY
#
# Switch profile:
#   CH_PROFILE=quickstart → SQLite + mock + memory scheduler (local dev)
#   CH_PROFILE=personal   → SQLite + ollama + sqlite scheduler
# ============================================================

# Active profile
CH_PROFILE=production

# App
APP_ENV=production
LOG_LEVEL=WARNING
# REQUIRED: replace with a cryptographically random secret (>= 32 chars)
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET

# Database (PostgreSQL — required for production)
# REQUIRED: update with your actual DB credentials
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/context_hub

# Scheduler backend (PostgreSQL — persistent, cluster-safe)
SCHEDULER_BACKEND=postgres
# The scheduler uses a sync psycopg2 URL internally (auto-converted from DATABASE_URL).
# Set this only if your scheduler DB is separate from the main DB:
# SCHEDULER_DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/context_hub

# Ingest mode (live — real API calls)
INGEST_MODE=live

# LLM provider (claude-code — subscription, subprocess-based)
LLM_PROVIDER=claude-code
CLAUDE_CODE_TIMEOUT_SECONDS=120.0

# Embedding provider (BGE-M3 — local, 1024-dim)
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_DEVICE=cpu

# --- Slack integration (REQUIRED when INGEST_MODE=live with Slack sources) ---
# SLACK_BOT_TOKEN=xoxb-your-production-token

# --- Backlog integration (REQUIRED when INGEST_MODE=live with Backlog sources) ---
# BACKLOG_API_KEY=your-api-key
# BACKLOG_SPACE_KEY=your-space-key

# --- Redmine integration (REQUIRED when INGEST_MODE=live with Redmine sources) ---
# REDMINE_API_KEY=your-api-key
# REDMINE_BASE_URL=https://your-redmine.example.com
