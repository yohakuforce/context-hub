# Context-Hub Environment Variables
# Copy this file to .env and fill in the actual values on the target machine.
# NEVER commit .env to the repository.

# --- Database ---
DB_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@db:5432/context_hub

# --- OpenAI (Embedding + Structuring LLM) ---
OPENAI_API_KEY=sk-...

# --- LLM Provider Selection ---
# Options: claude, openai, antigravity, codex
LLM_PROVIDER=claude

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- Antigravity (Google DeepMind) ---
# ANTIGRAVITY_API_KEY=...
# ANTIGRAVITY_MODEL=...

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...

# --- Backlog ---
BACKLOG_API_KEY=...
BACKLOG_SPACE_KEY=your-space

# --- Redmine ---
REDMINE_API_KEY=...
REDMINE_BASE_URL=https://your-redmine-instance.example.com

# --- Whisper ---
# Options: medium, large-v3
WHISPER_MODEL=medium

# --- App Settings ---
APP_ENV=development
SECRET_KEY=change_me_for_production_use_openssl_rand_hex_32
LOG_LEVEL=INFO

# --- Context Hub API Key (for MCP / consumers) ---
# Generated automatically on first run; override here to pin a value.
# CONTEXT_HUB_API_KEY=ctx-hub-...
